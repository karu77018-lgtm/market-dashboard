{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "pages/api/*.js": {
      "maxDuration": 60
    },
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "jev-prod": true
    }
  },
  "rewrites": [
    {
      "source": "/api/research/feature_probe",
      "destination": "/api/research/feature_probe.py"
    }
  ]
}
